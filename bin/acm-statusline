#!/bin/sh
# statusline wrapper for acm.
# Saves rate_limits from the statusline input per account, then runs the existing statusline command as is.
# Prefixes the first line with an [account] tag.
input=$(cat)
dir="${ACM_HOME:-$HOME/.acm}"

acc="$ACM_ACCOUNT"
if [ -f "$dir/accounts.json" ]; then
  # Use the account acm set if it is a Claude account in the list. A session started without acm,
  # or one started before the account was set up and holding an id not in the list, finds its account by CLAUDE_CONFIG_DIR.
  # If accounts.json cannot be read, use the account acm set as is
  if found=$(jq -r --arg a "$acc" --arg d "${CLAUDE_CONFIG_DIR:-}" '
      .accounts as $all
      | if $a != "" and ($all[$a] | type) == "object" and (($all[$a].tool // "claude") == "claude") then $a
        else ($all | to_entries[] | select((.value.tool // "claude") == "claude" and (.value.dir // "") == $d) | .key) end' \
      "$dir/accounts.json" 2>/dev/null); then
    acc=$(printf '%s\n' "$found" | head -1)
  fi
fi

if [ -n "$acc" ]; then
  # If the state folder was deleted while the session runs, recreate it owner-only
  (umask 077; mkdir -p "$dir/usage")
  rec="$dir/usage/$acc.json"
  tmp="$dir/usage/.$acc.$$"
  # Leave no empty temp file if Claude Code cuts the statusline off midway. SIGKILL cannot be caught
  trap 'rm -f "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  # Claude Code drops a window from the input once its reset time passes. A dropped window keeps its last record instead of null.
  # Each window stores the time it was received in at, so acm treats an account as having no 5-hour limit
  # (verified Ultra account) only when the 5h window has been missing for over a day
  record() {
    printf '%s' "$input" | jq -c --arg a "$acc" --slurpfile p "$1" '
      (now | floor) as $t
      | (($p[0] // {}) | if type == "object" then . else {} end) as $old
      | def keep(w): if (w | type) == "object" then (w | .at //= ($old.updated_at // $t)) else null end;
      select(.rate_limits.five_hour or .rate_limits.seven_day)
      | {account: $a,
         five_hour: (if .rate_limits.five_hour then .rate_limits.five_hour + {at: $t} else keep($old.five_hour) end),
         seven_day: (if .rate_limits.seven_day then .rate_limits.seven_day + {at: $t} else keep($old.seven_day) end),
         model: (.model.id // $old.model),
         updated_at: $t}
      | with_entries(select(.value != null))'
  }
  prev="$rec"
  [ -s "$prev" ] || prev=/dev/null
  # If the last record is corrupt, treat it as missing and write a new one
  record "$prev" > "$tmp" 2>/dev/null || record /dev/null > "$tmp" 2>/dev/null
  if [ -s "$tmp" ]; then mv "$tmp" "$rec"; else rm -f "$tmp"; fi
fi

label="$ACM_LABEL"
if [ -z "$label" ] && [ -n "$acc" ]; then
  label=$(jq -r --arg k "$acc" \
    '.accounts[$k] | .label // ((.email // "") | split("@")[0] | select(. != "")) // $k' "$dir/accounts.json" 2>/dev/null)
  [ -z "$label" ] && label="$acc"
fi

# With two or more Claude accounts, the tag also lists every account's usage, so one session's statusline shows where
# the others stand: [label · cl1 62% · cl2 5/66%]. One number is Week, two are 5h/Week. A trailing ? means the record is over
# an hour old. The numbers come from the records acm already keeps (this wrapper's and the /usage poll's), with the same rules
# as acm status: the more recent record wins per window, a window past its reset counts as 0, and a 5h window not seen for a day
# is dropped. `acm statusline-usage off` turns it off
usage_tag() {
  set --
  for f in "$dir"/usage/*.json "$dir"/poll/*.json; do
    [ -s "$f" ] && set -- "$@" "$f"
  done
  [ $# -gt 0 ] || return 0
  jq -rn --slurpfile cfg "$dir/accounts.json" --argjson now "$(date +%s)" '
    def pct: if ((.resets_at // 0) | tonumber? // 0) as $r | ($r > 0 and $r <= $now) then 0 else (.used_percentage | tonumber? // 0) end;
    ($cfg[0] // {}) as $c
    | if $c.statusline_usage == false then empty else
      (reduce inputs as $r ({};
        (input_filename | split("/")) as $p
        | (if $p[-2] == "poll" then ($r.usage // {}) else $r end) as $rec
        | if ($rec | type) == "object" then .[$p[-1] | rtrimstr(".json")] += [$rec] else . end)) as $recs
      | [ ($c.accounts // {} | keys_unsorted[]) as $id
          | select(($c.accounts[$id] | type) == "object" and (($c.accounts[$id].tool // "claude") == "claude"))
          | ($recs[$id] // []) as $rs
          | def latest(k): [$rs[] | select((.[k] | type) == "object") | {at: (.[k].at // .updated_at // 0), w: .[k]}] | max_by(.at);
            latest("five_hour") as $five | latest("seven_day") as $seven
          | select($seven != null or $five != null)
          | ([$rs[] | .updated_at // 0] | max) as $at
          | $id + " "
            + (if $five != null and ($now - $five.at) < 86400 then ($five.w | pct | round | tostring) + "/" else "" end)
            + (if $seven != null then ($seven.w | pct | round | tostring) else "0" end) + "%"
            + (if ($now - $at) > 3600 then "?" else "" end) ]
      | if length >= 2 then join(" · ") else empty end
    end' "$@" 2>/dev/null
}
if [ -n "$label" ] && [ -f "$dir/accounts.json" ]; then
  summary=$(usage_tag)
  [ -n "$summary" ] && label="$label · $summary"
fi

# The original statusline command sits in the settings.json statusLine command, as arguments to this wrapper.
# It is not read from a separate acm file. Claude Code does not protect such a file, so a session could change it without asking
inner="$*"
[ -z "$inner" ] && { [ -n "$label" ] && printf '[%s]\n' "$label"; exit 0; }

printf '%s' "$input" | sh -c "$inner" | {
  if IFS= read -r first || [ -n "$first" ]; then
    if [ -n "$label" ]; then printf '[%s] %s\n' "$label" "$first"; else printf '%s\n' "$first"; fi
    cat
  fi
}
