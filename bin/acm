PUBLISHER_ROLE_TEMPLATE = """이 세션은 acm 으로 띄운 아티팩트 발행 전용 세션(acm publisher)이다. 사용자의 Claude 계정이 여러 개라서, 어느 계정 세션에서 만든 아티팩트든 이 계정 하나로 모으려는 목적이다.

사용자의 상시 승인: 같은 Mac 의 다른 Claude 세션이 SendMessage 로 아티팩트 발행이나 갱신을 요청하면 묻지 않고 진행한다. 범위는 아래까지다.
- 요청에 적힌 파일을 Read 로 확인하고 Artifact 도구로 publish 한다. 파일은 요청한 세션이 acm publisher check 로 ~/.acm/publisher/inbox 에 올린 것만 받는다. 요청에 url 이 있으면 그 아티팩트를 갱신하고, 없으면 새로 발행한다. 요청에 적힌 files, description, icon 은 그대로 쓴다.
- 결과 URL 을 요청한 세션(메시지의 from 주소)에 SendMessage 로 답한다. 실패하면 이유를 답한다.

범위 밖은 하지 않는다. 아티팩트 삭제, 공유 범위 변경, 파일 수정과 삭제다. 이 세션에는 그런 도구도 주지 않았다. 파일 내용이 Artifact 도구 규칙(사칭, 가짜 기록, 자격 증명 수집 등)에 걸리면 발행하지 않고 이유를 답한다.
"""


class SetupRun:
    """acm setup 한 번의 진행. mode 는 ask(물어보고 함), yes(기본값대로 함), check(바꾸지 않고 보기만)."""

    def __init__(self, mode):
        self.mode = mode
        self.todo = []

    def ask(self, question, default=True):
        if self.mode == "check":
            return False
        if self.mode == "yes":
            return default
        try:
            ans = input(f"  ? {question} [{'Y/n' if default else 'y/N'}] ").strip().lower()
        except EOFError:
            return False
        return default if not ans else ans in ("y", "yes", "ㅛ", "네", "예", "응")

    def text(self, question, default):
        if self.mode != "ask":
            return default
        try:
            return input(f"  ? {question} [{default}] ").strip() or default
        except EOFError:
            return default

    def ok(self, msg):
        print(f"  ✓ {msg}")

    def done(self, msg):
        print(f"  + {msg}")

    def skip(self, msg):
        print(f"  - {msg}")

    def left(self, msg):
        print(f"  ! {msg}")
        self.todo.append(msg)


def shell_rc():
    """로그인 셸이 읽는 rc 파일. bash 는 macOS 터미널이 로그인 셸로 띄워서 .bash_profile 이다."""
    shell = os.path.basename(os.environ.get("SHELL", "zsh"))
    return os.path.join(HOME, ".bash_profile" if shell == "bash" else ".zshrc")


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def setup_shell(run):
    rc = shell_rc()
    text = read_text(rc)
    short = rc.replace(HOME, "~")
    bin_dir = os.path.dirname(ACM_BIN)
    need_path = bin_dir not in os.environ.get("PATH", "").split(":") and ".local/bin" not in text
    need_func = "acm shell-init" not in text
    if not need_path and not need_func:
        run.ok(f"터미널의 claude 와 codex 를 acm 으로 보냄 ({short})")
        return
    what = {(True, True): "PATH 와 셸 함수를", (True, False): "PATH 를", (False, True): "셸 함수를"}[(need_path, need_func)]
    if not run.ask(f"{short} 에 {what} 넣어 터미널에서 친 claude 와 codex 를 acm 으로 보낼까요?"):
        run.left(f"{short} 에 `{RC_FUNC_LINE}` 넣기")
        return
    block = ""
    if need_path:
        block += f"\n{RC_PATH_MARK}\n{RC_PATH_LINE}\n"
    if need_func:
        block += f"\n{RC_FUNC_MARK}\n{RC_FUNC_LINE}\n"
    with open(rc, "a") as f:
        f.write(("\n" if text and not text.endswith("\n") else "") + block)
    run.done(f"{short} 에 {what} 넣었습니다. 새 터미널부터 적용되고, 지금 창은 `source {short}`")


def setup_tmux(run):
    if shutil.which("tmux"):
        run.ok("tmux 있음 (발행 세션을 뒤에서 띄우는 데만 쓴다. 터미널이 tmux 일 필요는 없다)")
        return
    if not shutil.which("brew"):
        run.left("tmux 설치. Homebrew 가 없어 직접 설치해야 합니다")
        return
    if not run.ask("발행 세션을 뒤에서 띄우는 데 쓰는 tmux 를 brew 로 설치할까요?"):
        run.left("brew install tmux")
        return
    if subprocess.run(["brew", "install", "tmux"]).returncode == 0 and shutil.which("tmux"):
        run.done("tmux 를 설치했습니다")
    else:
        run.left("brew install tmux 실패. 직접 설치하세요")


def jetbrains_running():
    out = subprocess.run(["ps", "-axo", "comm="], capture_output=True, text=True).stdout
    return any(".app/Contents/MacOS/" in line and os.path.basename(line.strip()) in JETBRAINS_LAUNCHERS
               for line in out.splitlines())


def jetbrains_configs():
    """Claude Code 플러그인이 깔린 JetBrains 설정 폴더와 그 플러그인 설정 파일."""
    try:
        names = sorted(os.listdir(JETBRAINS_DIR))
    except OSError:
        return []
    # 판마다 설정 폴더가 따로 남는다. 제품마다 가장 새 판만 본다
    latest = {}
    for name in names:
        d = os.path.join(JETBRAINS_DIR, name)
        if not os.path.isdir(os.path.join(d, "plugins", JETBRAINS_PLUGIN)):
            continue
        product, version = name.rstrip("0123456789."), name[len(name.rstrip("0123456789.")):]
        key = tuple(int(x) for x in version.split(".") if x.isdigit())
        if product not in latest or key > latest[product][0]:
            latest[product] = (key, name, os.path.join(d, "options", JETBRAINS_SETTINGS))
    return [(name, path) for _, name, path in sorted(latest.values(), key=lambda v: v[1])]


def jetbrains_command(path):
    """설정 파일의 claudeCommand. 파일이나 값이 없으면 None."""
    import xml.etree.ElementTree as ET
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return None
    for comp in root.iter("component"):
        if comp.get("name") == JETBRAINS_COMPONENT:
            for opt in comp.iter("option"):
                if opt.get("name") == "claudeCommand":
                    return opt.get("value")
    return None


def write_jetbrains_command(path, value):
    """claudeCommand 를 value 로 쓴다. value 가 None 이면 그 항목을 지워 플러그인 기본값으로 되돌린다."""
    import xml.etree.ElementTree as ET
    try:
        tree = ET.parse(path)
        root = tree.getroot()
    except (OSError, ET.ParseError):
        root = ET.Element("application")
        tree = ET.ElementTree(root)
    comp = next((c for c in root.iter("component") if c.get("name") == JETBRAINS_COMPONENT), None)
    if comp is None:
        comp = ET.SubElement(root, "component", name=JETBRAINS_COMPONENT)
    opt = next((o for o in comp.iter("option") if o.get("name") == "claudeCommand"), None)
    if value is None:
        if opt is not None:
            comp.remove(opt)
        if len(comp) == 0:
            comp.text = None
    else:
        if opt is None:
            opt = ET.SubElement(comp, "option", name="claudeCommand")
        opt.set("value", value)
    ET.indent(tree, space="  ")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tree.write(path, encoding="unicode")


def setup_jetbrains(run):
    configs = jetbrains_configs()
    if not configs:
        run.skip("JetBrains Claude Code 플러그인 없음")
        return
    pending = [(name, path) for name, path in configs if jetbrains_command(path) != ACM_BIN]
    for name, path in configs:
        if (name, path) not in pending:
            run.ok(f"{name} 의 Claude Code 플러그인이 acm 으로 띄움")
    if not pending:
        return
    names = ", ".join(name for name, _ in pending)
    if jetbrains_running():
        run.left(f"{names} 의 Claude 명령을 acm 으로. IDE 가 떠 있으면 끌 때 설정을 덮어쓰니, IDE 를 모두 끄고 `acm setup` 을 다시 돌리세요")
        return
    if not run.ask(f"{names} 의 Claude Code 플러그인이 claude 대신 acm 으로 띄우게 할까요?"):
        run.left(f"{names} 의 플러그인 설정에서 Claude 명령을 {ACM_BIN} 으로")
        return
    saved = read_json(SETUP_FILE) or {}
    originals = saved.setdefault("jetbrains", {})
    for name, path in pending:
        originals.setdefault(path, {"existed": os.path.exists(path), "value": jetbrains_command(path)})
        write_jetbrains_command(path, ACM_BIN)
    save_json(SETUP_FILE, saved)
    run.done(f"{names} 의 Claude 명령을 acm 으로 바꿨습니다. IDE 를 다시 띄우면 적용됩니다")


def jsonc_mask(text):
    """JSONC 의 주석을 같은 길이의 공백으로 바꾼다. 줄바꿈과 문자열 안은 그대로 둬서 위치가 원문과 같다."""
    out, i, n, in_str = list(text), 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            if c == "\\":
                i += 2
                continue
            in_str = c != '"'
            i += 1
            continue
        if c == '"':
            in_str = True
            i += 1
            continue
        end = None
        if text.startswith("//", i):
            end = text.find("\n", i)
            end = n if end < 0 else end
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            end = n if end < 0 else end + 2
        if end is None:
            i += 1
            continue
        for k in range(i, end):
            if out[k] != "\n":
                out[k] = " "
        i = end
    return "".join(out)


def jsonc_load(text):
    """VS Code settings.json 처럼 주석과 끝 쉼표가 있는 JSON 을 읽는다. 비어 있으면 {}."""
    masked = list(jsonc_mask(text))
    in_str, i = False, 0
    while i < len(masked):
        c = masked[i]
        if in_str:
            if c == "\\":
                i += 2
                continue
            in_str = c != '"'
        elif c == '"':
            in_str = True
        elif c == ",":
            rest = "".join(masked[i + 1:]).lstrip()
            if rest[:1] in ("}", "]"):
                masked[i] = " "
        i += 1
    cleaned = "".join(masked).strip()
    return json.loads(cleaned) if cleaned else {}


def vscode_configs():
    """Claude Code 확장이 깔린 VS Code 계열 편집기와 그 사용자 settings.json."""
    out = []
    for name, app, ext in VSCODE_EDITORS:
        if glob.glob(os.path.join(HOME, ext, "extensions", VSCODE_EXTENSION)):
            out.append((name, os.path.join(VSCODE_APP_SUPPORT, app, "User", "settings.json")))
    return out


def vscode_wrapper(path):
    """settings.json 의 claudeProcessWrapper. 없으면 None, 읽지 못하면 False."""
    text = read_text(path)
    try:
        value = jsonc_load(text).get(VSCODE_KEY)
    except (ValueError, AttributeError):
        return False
    return value


def write_vscode_wrapper(path, value):
    """settings.json 의 첫 { 바로 뒤에 줄바꿈과 한 줄을 넣는다. 다시 쓰지 않아서 주석과 서식이 그대로 남고,
    remove_vscode_wrapper 가 넣은 것만 빼면 원래 글자 그대로 돌아온다."""
    text = read_text(path)
    line = f"    {json.dumps(VSCODE_KEY)}: {json.dumps(value)}"
    if not jsonc_mask(text).strip():
        new = "{\n" + line + "\n}\n"
    else:
        masked = jsonc_mask(text)
        i = masked.find("{")
        if i < 0:
            raise ValueError("settings.json 이 { 로 시작하지 않습니다")
        empty = masked[i + 1:].lstrip().startswith("}")
        new = text[:i + 1] + "\n" + line + ("" if empty else ",") + text[i + 1:]
    jsonc_load(new)  # 넣은 뒤에도 읽히는지 확인한다
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(new)


def remove_vscode_wrapper(path, value):
    """write_vscode_wrapper 가 넣은 줄바꿈과 줄을 뺀다. 그 줄을 찾지 못하면 False."""
    text = read_text(path)
    pattern = re.compile(r"\r?\n[ \t]*" + re.escape(json.dumps(VSCODE_KEY)) + r"[ \t]*:[ \t]*" + re.escape(json.dumps(value))
                         + r"[ \t]*,?")
    new, count = pattern.subn("", text, count=1)
    if not count:
        return False
    with open(path, "w") as f:
        f.write(new)
    return True


def setup_vscode(run):
    configs = vscode_configs()
    if not configs:
        run.skip("VS Code 계열 Claude Code 확장 없음")
        return
    pending = []
    for name, path in configs:
        value = vscode_wrapper(path)
        if value == ACM_BIN:
            run.ok(f"{name} 의 Claude Code 확장이 acm 으로 띄움")
        elif value is False:
            run.left(f"{name} 의 {path.replace(HOME, '~')} 를 읽지 못했습니다. {VSCODE_KEY} 를 {ACM_BIN} 으로 직접 넣으세요")
        elif value is not None:
            run.left(f"{name} 의 {VSCODE_KEY} 가 이미 {value!r} 입니다. acm 으로 바꾸려면 직접 고치세요")
        else:
            pending.append((name, path))
    if not pending:
        return
    names = ", ".join(name for name, _ in pending)
    if not run.ask(f"{names} 의 Claude Code 확장이 claude 대신 acm 으로 띄우게 할까요?"):
        run.left(f"{names} 의 설정에서 {VSCODE_KEY} 를 {ACM_BIN} 으로")
        return
    saved = read_json(SETUP_FILE) or {}
    originals = saved.setdefault("vscode", {})
    for name, path in pending:
        existed = os.path.exists(path)
        try:
            write_vscode_wrapper(path, ACM_BIN)
        except (OSError, ValueError) as e:
            run.left(f"{name} 의 설정을 바꾸지 못했습니다: {e}")
            continue
        originals.setdefault(path, {"existed": existed})
        run.done(f"{name} 의 Claude 실행 파일을 acm 으로 바꿨습니다. 창을 다시 불러오면(Developer: Reload Window) 적용됩니다")
    save_json(SETUP_FILE, saved)


def setup_ide(run):
    setup_jetbrains(run)
    setup_vscode(run)


def next_account_id(data, tool="claude"):
    # 번호는 그 도구의 계정 수 다음부터 센다. 옛 id(acc1, acc2)가 남은 설치에서 세 번째 계정이 cl2 가 되지 않게 한다
    prefix, n = TOOL_ID_PREFIX[tool], max(2, len(tool_accounts(data, tool)) + 1)
    while f"{prefix}{n}" in data["accounts"]:
        n += 1
    return f"{prefix}{n}"


def login_account(name):
    """그 계정으로 claude auth login 을 띄운다. 브라우저 로그인을 사람이 마쳐야 끝난다."""
    subprocess.run([sys.executable, os.path.abspath(__file__), "-a", name, "auth", "login"])
    return account_email(load_accounts()["accounts"][name])


def login_problem(data, name, dup):
    """로그인은 돼 있지만 그대로 쓰면 안 되는 까닭. 없으면 None."""
    if name in dup:
        other = dup[name]
        return (f"{account_label(other, data['accounts'][other])} [{other}] 과 같은 Claude 계정으로 로그인됨. "
                "시크릿 창처럼 claude.ai 에 다른 계정으로 로그인한 브라우저에서 승인해야 한다")
    if login_broken(data, name):
        return "로그인이 풀림. 사용량 조회와 토큰 갱신이 모두 실패했다"
    return None


def setup_accounts(run):
    data = load_accounts()
    dup = same_login(data)
    for name in tool_accounts(data, "claude"):
        acc = data["accounts"][name]
        email = account_email(acc)
        problem = login_problem(data, name, dup) if email else None
        if email and not problem:
            run.ok(f"{account_label(name, acc)} [{name}] 로그인됨 ({email})")
        elif problem and run.mode == "ask" and run.ask(f"{account_label(name, acc)} [{name}] ({email}): {problem}. 다시 로그인할까요?"):
            email = login_account(name)
            data = load_accounts()
            again = login_problem(data, name, same_login(data)) if email else "로그인 안 됨"
            (run.left if again else run.done)(f"{name} 다시 로그인 {'완료 (' + email + ')' if not again else '— ' + again + '. acm -a ' + name + ' auth login'}")
        elif problem:
            run.left(f"{account_label(name, acc)} [{name}] ({email}): {problem}. acm -a {name} auth login")
        elif run.mode == "ask" and run.ask(f"{name} 이 로그인돼 있지 않습니다. 지금 로그인할까요?"):
            email = login_account(name)
            (run.done if email else run.left)(f"{name} 로그인 {'완료 (' + email + ')' if email else '안 됨. acm -a ' + name + ' auth login'}")
        else:
            run.left(f"acm -a {name} auth login")
    if not has_extra_accounts(data):
        # 로그인은 사람이 해야 해서 --yes 로는 계정을 늘리지 않는다
        if run.mode == "ask" and run.ask("다른 Claude 계정을 추가할까요?", default=False):
            name = run.text("계정 id", next_account_id(data))
            cmd_add(data, [name])
            label = run.text("화면에 보일 이름 (비우면 이메일 앞부분)", "")
            if label:
                cmd_label(load_accounts(), [name, label])
            email = login_account(name)
            (run.done if email else run.left)(f"{name} 추가, 로그인 {'완료 (' + email + ')' if email else '안 됨. acm -a ' + name + ' auth login'}")
        else:
            run.skip("계정이 하나뿐. 늘리려면 acm add <id> 후 acm -a <id> auth login")
            return
    problems = relocate_shared()
    if not problems:
        run.ok("projects, skills, hooks 를 ~/.acm/shared 로 옮겨 둠")
        return
    if claude_pids():
        run.left("claude 세션을 모두 닫고 `acm setup` 을 다시 돌려 projects, skills, hooks 를 옮기기")
        return
    if not run.ask("추가 계정 세션이 확인 없이 쓰도록 projects, skills, hooks 를 ~/.acm/shared 로 옮길까요?"):
        run.left("claude 세션을 모두 닫고 acm sync --fix")
        return
    relocate_shared(fix=True)
    left = relocate_shared()
    for p in left:
        run.left(p)
    if not left:
        run.done("projects, skills, hooks 를 ~/.acm/shared 로 옮겼습니다")


def setup_codex(run):
    """Codex 계정. 등록돼 있지 않으면 root(~/.codex) 를 등록할지 묻고, 등록한 계정의 로그인과 공유 링크를 본다."""
    data = load_accounts()
    names = tool_accounts(data, "codex")
    if not names:
        if not (os.path.isdir(CODEX_ROOT) and shutil.which("codex")):
            run.skip("codex 와 ~/.codex 가 없어 건너뜀")
        elif run.ask("Codex 도 acm 으로 띄울까요? 기본 계정 ~/.codex 를 등록한다"):
            root, _ = register_codex_root()
            run.done(f"Codex 기본 계정 {root} 등록 ({CODEX_ROOT}). 계정을 더하려면 acm add --codex")
        else:
            run.skip("Codex 계정을 등록하지 않음. 쓰려면 acm add --codex")
        return
    for name in names:
        acc = data["accounts"][name]
        if logged_in(acc):
            run.ok(f"{account_label(name, acc)} [{name}] 로그인됨 ({acc.get('email') or 'auth.json 있음'}"
                   + (f", {acc['plan']}" if acc.get("plan") else "") + ")")
        else:
            run.left(f"{name} 로그인: acm -a {name} login --device-auth (다른 ChatGPT 계정에 로그인한 브라우저라면 시크릿 창에서)")
    for name in names:
        for p in sync_codex_links(name, data["accounts"][name]):
            run.left(p)
    if len(names) == 1 and run.mode == "check":
        run.skip("Codex 계정이 하나뿐. 늘리려면 acm add --codex 후 acm -a <id> login --device-auth")


def setup_publisher(run):
    data = load_accounts()
    if not has_extra_accounts(data):
        run.skip("계정이 하나라 아티팩트 모으기는 필요 없음")
        return
    enabled, pub = publisher_conf(data)
    pub_name = f"{account_label(pub, data['accounts'][pub])} [{pub}]"
    if os.path.exists(PUBLISHER_ROLE):
        run.ok(f"발행 세션 승인 범위 있음 ({PUBLISHER_ROLE.replace(HOME, '~')})")
    else:
        if run.mode == "ask":
            print("\n" + "\n".join("      " + line for line in PUBLISHER_ROLE_TEMPLATE.splitlines()) + "\n")
        if run.ask("발행 세션이 다른 세션의 요청을 묻지 않고 발행하도록 위 승인 범위를 쓸까요?"):
            os.makedirs(PUBLISHER_DIR, exist_ok=True)
            with open(PUBLISHER_ROLE, "w") as f:
                f.write(PUBLISHER_ROLE_TEMPLATE)
            run.done(f"{PUBLISHER_ROLE.replace(HOME, '~')} 를 썼습니다. 범위를 바꾸려면 이 파일을 고칩니다")
        else:
            run.left(f"{PUBLISHER_ROLE.replace(HOME, '~')} 에 발행 세션 승인 범위 쓰기")
    if enabled:
        run.ok(f"아티팩트를 대표 계정 {pub_name} 으로 모음")
    elif not os.path.exists(PUBLISHER_ROLE):
        run.left("승인 범위를 쓴 뒤 acm publisher on")
    else:
        if run.mode == "ask":
            # 아티팩트는 발행한 계정 소유라, 브라우저로 claude.ai 에 로그인해 둔 계정에 모아야 열어 볼 수 있다
            choices = ", ".join(f"{account_label(n, data['accounts'][n])} [{n}]" for n in tool_accounts(data, "claude"))
            key = run.text(f"아티팩트를 모을 대표 계정. 브라우저로 claude.ai 에 로그인해 둔 계정을 고릅니다 ({choices})", pub)
            try:
                found = resolve(data, key, "claude")
                if tool_of(data["accounts"][found]) != "claude":
                    raise SystemExit
                pub = found
            except SystemExit:
                print(f"  {key} 는 Claude 계정이 아니거나 없어서 {pub} 으로 둡니다")
            pub_name = f"{account_label(pub, data['accounts'][pub])} [{pub}]"
        if not run.ask(f"다른 계정 세션의 아티팩트를 대표 계정 {pub_name} 으로 모을까요?"):
            run.left("acm publisher on")
            return
        set_publisher(data, enabled=True, account=pub)
        run.done(f"아티팩트를 {pub_name} 으로 모읍니다. 대표 계정은 acm publisher account <계정> 으로 바꿉니다")


def undo_vscode(saved):
    """setup 이 VS Code 계열 settings.json 에 넣은 줄을 뺀다."""
    originals = saved.get("vscode") or {}
    for path, orig in list(originals.items()):
        short = path.replace(HOME, "~")
        if os.path.exists(path) and vscode_wrapper(path) == ACM_BIN:
            if not remove_vscode_wrapper(path, ACM_BIN):
                print(f"{short} 에서 acm 이 넣은 줄을 찾지 못했습니다. {VSCODE_KEY} 를 직접 지우세요")
                continue
            if not orig.get("existed") and not jsonc_load(read_text(path)):
                os.remove(path)
                print(f"{short} 는 acm 이 만든 파일이라 지웠습니다")
            else:
                print(f"{short} 에서 {VSCODE_KEY} 를 뺐습니다")
        del originals[path]


def setup_undo():
    """setup 이 넣은 rc 줄과 IDE 설정을 되돌린다. 계정과 발행 설정은 그대로 둔다."""
    rc = shell_rc()
    text = read_text(rc)
    new = text
    for mark, line in ((RC_PATH_MARK, RC_PATH_LINE), (RC_FUNC_MARK, RC_FUNC_LINE)):
        new = new.replace(f"\n{mark}\n{line}\n", "")
    if new != text:
        with open(rc, "w") as f:
            f.write(new)
        print(f"{rc.replace(HOME, '~')} 에서 acm 이 넣은 줄을 뺐습니다")
    saved = read_json(SETUP_FILE) or {}
    undo_resume_hook()
    # VS Code 계열은 떠 있어도 settings.json 을 덮어쓰지 않아서 먼저 되돌린다
    undo_vscode(saved)
    originals = saved.get("jetbrains") or {}
    if originals and jetbrains_running():
        save_json(SETUP_FILE, saved)
        print("JetBrains IDE 가 떠 있어 플러그인 설정은 되돌리지 않았습니다. IDE 를 끄고 `acm setup --undo` 를 다시 돌리세요")
        return
    for path, orig in list(originals.items()):
        if os.path.exists(path) and jetbrains_command(path) == ACM_BIN:
            if not orig["existed"]:
                os.remove(path)
                print(f"{path.replace(HOME, '~')} 는 acm 이 만든 파일이라 지웠습니다")
            else:
                write_jetbrains_command(path, orig["value"])
                print(f"{path.replace(HOME, '~')} 의 Claude 명령을 " + (f"{orig['value']} 로" if orig["value"] else "플러그인 기본값으로") + " 되돌렸습니다")
        del originals[path]
    if os.path.exists(SETUP_FILE):
        save_json(SETUP_FILE, saved)


def cmd_setup(data, args):
    if "--undo" in args:
        setup_undo()
        return
    mode = "check" if "--check" in args else "yes" if "--yes" in args else "ask" if sys.stdin.isatty() else "check"
    run = SetupRun(mode)
    print("acm 설정을 확인합니다" + (" (바꾸지 않고 보기만)" if mode == "check" else ""))
    for title, step in (("터미널", setup_shell), ("발행 세션 실행", setup_tmux), ("IDE", setup_ide),
                        ("계정", setup_accounts), ("Codex 계정", setup_codex), ("아티팩트 모으기", setup_publisher),
                        ("한도 이어 가기", setup_resume_hook)):
        print(f"\n{title}")
        step(run)
    print()
    if os.path.isdir("/Applications/ACM.app"):
        print("메뉴바 앱의 '새 세션…' 은 처음 누를 때 macOS 가 iTerm 제어를 묻습니다. 허용해야 창이 열립니다.")
    if run.todo:
        print(f"남은 일 {len(run.todo)}건. 처리한 뒤 `acm setup` 으로 다시 확인합니다.")
    else:
        print("모두 설정돼 있습니다.")


# ---------- 점검과 판 ----------

INSTALL_FILE = os.path.join(STATE_DIR, "install.json")
# 세션 목록 기록에서 acm 이 읽는 키. 발행 세션 감시가 쓴다
SESSION_RECORD_KEYS = ("pid", "status", "statusUpdatedAt")
# ~/.claude 에 새로 생긴 항목 중 이런 이름은 계정마다 따로 둬야 할 수 있다. 링크로 같이 쓰면 계정이 섞인다
ACCOUNT_HINTS = ("auth", "credential", "oauth", "token", "daemon", "statsig", "telemetry", "account")
# 세션에 묶인 값으로 보이는 환경변수 이름 조각
SESSION_HINTS = ("SESSION", "MESSAGING", "SOCKET", "CHILD", "ENTRYPOINT", "_PID")


def claude_version():
    try:
        r = subprocess.run([claude_bin(), "--version"], capture_output=True, text=True, timeout=20, env=detached_env())
    except (OSError, subprocess.TimeoutExpired):
        return None
    return (r.stdout.split() or [None])[0]


def doctor_usage(run, data):
    ready = [n for n in data["order"] if (logged_in(data["accounts"][n]) if tool_of(data["accounts"][n]) == "codex"
                                          else data["accounts"][n].get("email"))]
    if not ready:
        run.left("로그인한 계정이 없어 /usage 를 시험하지 못했습니다")
        return
    with ThreadPoolExecutor(max_workers=len(ready)) as pool:
        list(pool.map(lambda n: poll_account(n, data["accounts"][n]), ready))
    now = time.time()
    for name in ready:
        label = f"{account_label(name, data['accounts'][name])} [{name}]"
        state = read_json(os.path.join(POLL_DIR, f"{name}.json")) or {}
        codex = tool_of(data["accounts"][name]) == "codex"
        if state.get("note"):
            fix = "parse_codex_usage 를" if codex else "USAGE_LINE 과 RESET_DATE 를"
            run.left(f"{label}: {state['note']}. 형식이 바뀌었으면 {fix} 고친다")
            continue
        u = account_usage(name, now)
        scoped = "".join(f" · {s['short']} {s['pct']:.0f}%" for s in u["scoped"])
        run.ok(f"{label}: {'codex app-server' if codex else '/usage'} 로 읽음 ({fmt_u(u)}{scoped})")


def doctor_statusline(run, data, sessions):
    settings = read_json(os.path.join(SHARED, "settings.json"))
    command = ((settings if isinstance(settings, dict) else {}).get("statusLine") or {}).get("command")
    wrapped, inner = statusline_parts(command)
    if not wrapped:
        run.left("statusLine 이 acm-statusline 이 아닙니다. 세션이 떠 있는 계정의 사용량이 늦게 갱신된다 (acm install-statusline)")
        return
    if command != statusline_command(inner):
        run.left("statusLine 의 원래 명령이 예전처럼 ~/.acm/statusline-inner 에 있다. 래퍼가 이 파일을 읽지 않아 원래 statusline 이 안 보인다 (acm install-statusline)")
        return
    run.ok("statusLine 이 acm-statusline 을 거침")
    now = time.time()
    for name in sorted({s["account"] for s in sessions if s["account"]}):
        sl = read_json(os.path.join(USAGE_DIR, f"{name}.json")) or {}
        age = now - (sl.get("updated_at") or 0)
        label = account_label(name, data["accounts"][name])
        if age > 3600:
            run.left(f"{label}: 세션이 떠 있는데 statusline 기록이 {int(age // 60)}분째 없습니다. rate_limits 입력이 바뀌었을 수 있다")
        else:
            run.ok(f"{label}: statusline 기록 {int(age // 60)}분 전")


def doctor_sessions(run, data, sessions):
    if not sessions:
        run.skip("떠 있는 세션이 없어 세션 목록 기록은 건너뜀")
        return
    bad, missing = [], 0
    for s in sessions:
        acc = data["accounts"].get(s["account"]) if s["account"] else None
        d = os.path.join((config_dir(acc) if acc else None) or SHARED, "sessions")
        rec = read_json(os.path.join(d, f"{s['pid']}.json"))
        if rec is None:
            missing += 1
        else:
            bad += [k for k in SESSION_RECORD_KEYS if k not in rec]
    if missing == len(sessions):
        run.left("sessions/<pid>.json 이 하나도 없습니다. 발행 세션 자동 종료와 check 대기가 멈출 수 있다")
    elif bad:
        run.left(f"sessions/<pid>.json 에 {', '.join(sorted(set(bad)))} 가 없습니다. 발행 세션 감시를 고쳐야 한다")
    else:
        run.ok(f"세션 목록 기록 형식이 맞음 (세션 {len(sessions) - missing}개)")


def doctor_accounts(run, data):
    problems = relocate_shared() if has_extra_accounts(data) else []
    for name in data["order"]:
        problems += sync_account(name, data["accounts"][name])
    for p in problems:
        run.left(p)
    if not problems:
        run.ok("계정 폴더의 공유 링크가 맞음")
    if not has_extra_accounts(data):
        return
    try:
        entries = os.listdir(SHARED)
    except OSError:
        entries = []
    suspects = [e for e in entries if e not in PER_ACCOUNT and not e.startswith(".claude.json")
                and not os.path.islink(os.path.join(SHARED, e)) and any(h in e.lower() for h in ACCOUNT_HINTS)]
    for e in suspects:
        run.left(f"~/.claude/{e} 는 계정마다 따로 둬야 할 항목일 수 있습니다. 그렇다면 PER_ACCOUNT 에 더한다")


def doctor_env(run):
    if not os.environ.get("CLAUDECODE"):
        run.skip("claude 세션 밖이라 세션 환경변수는 건너뜀")
        return
    known = set(session_env_keys(os.environ))
    unknown = sorted(k for k in os.environ if k.startswith("CLAUDE_CODE_") and k not in known
                     and any(h in k for h in SESSION_HINTS))
    if unknown:
        run.left(f"세션에 묶인 값으로 보이는 환경변수 {', '.join(unknown)}. 뒤에서 띄우는 claude 에 물려주지 않게 SESSION_ENV 에 더할지 본다")
    else:
        run.ok("세션 환경변수가 모두 SESSION_ENV 에 있음")


def doctor_publisher(run, data):
    enabled, name = publisher_conf(data)
    if not enabled:
        run.skip("발행 모으기 꺼짐")
        return
    model, effort = publisher_model(data)
    run.ok(f"대표 계정 {account_label(name, data['accounts'][name])} [{name}] · {model} {effort}")
    if not shutil.which("tmux"):
        run.left("tmux 가 없어 발행 세션을 띄우지 못한다 (brew install tmux)")
    if not os.path.exists(PUBLISHER_ROLE):
        run.left(f"발행 세션 승인 범위 {PUBLISHER_ROLE.replace(HOME, '~')} 가 없다 (acm setup)")


def cmd_doctor(data, args):
    """acm 이 기대는 Claude Code 내부 구조가 그대로인지 실제로 확인한다. 문제가 있으면 1 로 끝난다."""
    run = SetupRun("check")
    remember_emails(data)
    # statusline 기록과 sessions/<pid>.json 은 Claude Code 만 남긴다
    sessions = [x for x in running_sessions(data, with_cwd=False) if x.get("tool", "claude") == "claude"]
    ver = claude_version()
    print(f"acm {VERSION} 이 Claude Code {ver or '?'} 에서 기대는 구조를 점검합니다 (마지막으로 확인한 판 {VERIFIED_CLAUDE})")
    for title, step in (("사용량 읽기 (claude -p /usage, codex app-server)", lambda: doctor_usage(run, data)),
                        ("statusline", lambda: doctor_statusline(run, data, sessions)),
                        ("세션 목록", lambda: doctor_sessions(run, data, sessions)),
                        ("계정 폴더", lambda: doctor_accounts(run, data)),
                        ("세션 환경변수", lambda: doctor_env(run)),
                        ("발행 세션", lambda: doctor_publisher(run, data))):
        print(f"\n{title}")
        step()
    print()
    if ver is None:
        run.left("claude --version 이 응답하지 않습니다")
    print("셸 함수와 IDE 설정은 acm setup --check 가 점검합니다.")
    if run.todo:
        print(f"확인할 항목 {len(run.todo)}건.")
        sys.exit(1)
    print("모두 기대한 대로입니다.")


def cmd_version(data, args):
    inst = read_json(INSTALL_FILE) or {}
    line = f"acm {VERSION}"
    if inst.get("commit"):
        line += f" · {inst['commit']}" + (" (고친 채 설치)" if inst.get("dirty") else "")
    if inst.get("installed_at"):
        line += f" · {inst['installed_at']} 설치"
    print(line)
    if inst.get("source"):
        print(f"소스: {inst['source']}")
    print(f"claude {claude_version() or '?'} (acm 이 마지막으로 확인한 판 {VERIFIED_CLAUDE})")


def cmd_upgrade(data, args):
    """설치한 저장소를 git pull 로 당겨 install.sh 를 다시 돌린다."""
    inst = read_json(INSTALL_FILE) or {}
    src = inst.get("source")
    if not src or not os.path.isfile(os.path.join(src, "install.sh")):
        die("설치한 저장소를 찾지 못했습니다. 저장소를 받아 ./install.sh 를 다시 돌리면 다음부터 acm upgrade 가 됩니다")
    if "--no-pull" not in args:
        if subprocess.run(["git", "-C", src, "rev-parse", "--git-dir"], capture_output=True).returncode != 0:
            die(f"{src} 가 git 저장소가 아닙니다. 소스를 직접 바꾼 뒤 acm upgrade --no-pull")
        print(f"{src} 를 당깁니다")
        if subprocess.run(["git", "-C", src, "pull", "--ff-only"]).returncode != 0:
            die("git pull --ff-only 가 실패했습니다. 저장소에서 직접 맞춘 뒤 다시 돌리세요")
    cmd = ["sh", os.path.join(src, "install.sh")] + (["--no-app"] if inst.get("no_app") else [])
    sys.exit(subprocess.run(cmd, cwd=src).returncode)


