RC_FUNC_MARK = "# acm: 터미널에서 친 claude 를 acm 으로 보낸다"
RC_FUNC_LINE = 'if command -v acm >/dev/null 2>&1; then eval "$(acm shell-init)"; fi'
JETBRAINS_DIR = os.path.join(HOME, "Library", "Application Support", "JetBrains")
JETBRAINS_PLUGIN = "claude-code-jetbrains-plugin"
JETBRAINS_SETTINGS = "claude-code-plugin-settings.xml"
