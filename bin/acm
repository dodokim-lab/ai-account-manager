def add_flag(argv, flag, value, sep):
    """argv 에 flag 가 이미 있으면 그 값 뒤에 sep 로 이어 붙이고, 없으면 맨 앞에 넣는다.
    같은 플래그가 두 번 들어가면 claude 가 하나만 쓰니, 사용자나 IDE 확장이 넣은 값을 지우지 않게 합친다."""
    out, merged, i = [], False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            out += argv[i:]
            break
        if not merged and a == flag and i + 1 < len(argv):
            out += [flag, argv[i + 1] + sep + value]
            merged, i = True, i + 2
            continue
        if not merged and a.startswith(flag + "="):
            out.append(a + sep + value)
            merged, i = True, i + 1
            continue
        out.append(a)
        i += 1
    return out if merged else [flag, value] + out


def bundled_claude(arg):
    """VS Code 계열 확장이 claudeProcessWrapper 로 acm 을 부를 때 첫 인자로 넘기는 번들 claude 경로인지.
    확장 폴더(anthropic.claude-code-<버전>) 안의 실행 파일만 본다. 그렇지 않으면 `claude ./claude-setup.sh` 처럼
    실행 권한이 있는 파일 경로를 프롬프트로 넘겼을 때 acm 이 그 파일을 실행한다."""
    if not (os.path.isabs(arg) and os.path.basename(arg).lower().startswith("claude")):
        return False
    if not any(part.lower().startswith(VSCODE_EXTENSION[:-1]) for part in arg.split(os.sep)):
        return False
    return os.path.isfile(arg) and os.access(arg, os.X_OK)


def launch(data, argv, binary=None, reason=None, tool=None):
    """계정을 골라 claude 나 codex 를 띄운다. binary 는 IDE 확장이 넘긴 번들 claude 경로이고, 없으면 PATH 의 claude 다.
    reason 은 -a 로 계정을 정해 띄울 때 보일 까닭이다. tool 을 주지 않으면 -a 로 정한 계정의 도구, 없으면 Claude 다."""
    forced, mode = None, data.get("mode", "usage")
    while argv:
        if argv[0] in ("-a", "--acc") and len(argv) > 1:
            forced, argv = argv[1], argv[2:]
        elif argv[0] == "--rr":
            mode, argv = "rr", argv[1:]
        elif argv[0] == "--usage":
            mode, argv = "usage", argv[1:]
        else:
            break

    os.makedirs(STATE_DIR, exist_ok=True)
    if forced:
        own = tool_of(data["accounts"][resolve(data, forced, tool)])
        if tool and own != tool:
            die(f"{forced} 는 {TOOL_NAMES[own]} 계정입니다")
        tool = own
    if tool == "codex":
        return launch_codex(data, argv, forced, mode, reason)
    model = session_model(argv)
    if not forced and mode == "usage":
        remember_emails(data)
        # 조회는 뒤에서 돌리고 기다리지 않는다. 세션이 없는 계정은 사용량이 늘지 않아 몇 분 묵은 값으로 골라도 된다
        refresh_usage(data)
    with open(LOCK_FILE, "w") as lock:
        # 동시에 여러 세션을 띄워도 같은 계정으로 몰리지 않게 고르기와 등록을 묶는다
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load_accounts()
        remember_emails(data)
        if forced:
            name, why = resolve(data, forced, "claude"), reason or "지정"
        else:
            name, why = pick(data, mode, model)
            set_last_pick(data, "claude", name)
        acc = data["accounts"][name]
        for p in sync_links(name, acc):
            info(p)
        # MCP 와 개인 설정, 프로젝트 신뢰 정보도 띄울 때마다 기본 계정에 맞춘다
        sync_claude_json(acc)
        if has_extra_accounts(data):
            for p in relocate_shared():
                info(p)
        run = os.path.join(RUN_DIR, name)
        os.makedirs(run, exist_ok=True)
        # exec 하면 이 pid 가 그대로 claude 가 된다
        open(os.path.join(run, str(os.getpid())), "w").close()

    env = dict(os.environ)
    if config_dir(acc) is None:
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = config_dir(acc)
    env["ACM_ACCOUNT"] = name
    env["ACM_LABEL"] = account_label(name, acc)
    enabled, pub = publisher_conf(data)
    publish = enabled and name != pub and publisher_startable()
    # Chrome 확장은 대표 계정 하나에만 로그인돼 있어서, 다른 계정 세션의 화면 제어는 aside 로 돌린다
    browser = name != pub and aside_configured()
    if publish or browser:
        argv = add_flag(argv, "--append-system-prompt", session_rules(data, name, publish, browser), "\n\n")
    if publish:
        argv = add_flag(argv, "--disallowedTools", "Artifact", ",")
    if sys.stderr.isatty():
        info(f"{env['ACM_LABEL']} [{name}] ({acc.get('email') or '로그인 안 됨'}) · {why}"
             + (" · 아티팩트는 발행 세션에 맡김" if publish else "")
             + (" · 화면 제어는 aside" if browser else ""))
    if binary:
        os.execve(binary, [binary] + argv, env)
    try:
        os.execvpe("claude", ["claude"] + argv, env)
    except FileNotFoundError:
        found = claude_bin()
        if found == "claude":
            die("claude 실행 파일을 PATH 에서 찾지 못했습니다")
        os.execve(found, [found] + argv, env)


def launch_codex(data, argv, forced, mode, reason=None):
    """Codex 계정을 골라 codex 를 띄운다. 배정은 Codex 계정끼리만 하고, 대표 계정 예비 기준은 없다.
    세션 기록(sessions)은 ~/.codex 를 링크로 같이 쓰니 `acm codex resume <ID>` 는 어느 계정에서든 그 세션을 연다."""
    if not tool_accounts(data, "codex"):
        root, _ = register_codex_root()
        info(f"Codex 기본 계정 {root} 를 등록했습니다 ({CODEX_ROOT}). 계정을 더하려면 acm add --codex")
        data = load_accounts()
    if not forced and argv and argv[0] in CODEX_PASSTHROUGH:
        # 계정을 고를 일이 없는 하위 명령. 로그인은 acm -a <계정> login 으로 계정을 정해서 한다
        found = codex_bin()
        os.execv(found, [found] + argv) if os.path.isabs(found) else os.execvp(found, [found] + argv)
    if not forced and mode == "usage":
        remember_emails(data)
        refresh_usage(data)
    with open(LOCK_FILE, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        data = load_accounts()
        if forced:
            name, why = resolve(data, forced, "codex"), reason or "지정"
        else:
            name, why = pick(data, mode, None, tool="codex")
            set_last_pick(data, "codex", name)
        acc = data["accounts"][name]
        for p in sync_codex_links(name, acc):
            info(p)
        run = os.path.join(RUN_DIR, name)
        os.makedirs(run, exist_ok=True)
        open(os.path.join(run, str(os.getpid())), "w").close()

    env = dict(os.environ)
    if config_dir(acc) is None:
        env.pop("CODEX_HOME", None)
    else:
        env["CODEX_HOME"] = config_dir(acc)
    # ACM_ACCOUNT 는 쓰지 않는다. 이 세션 안에서 띄운 claude 의 statusline 래퍼가 ACM_ACCOUNT 를 보고
    # Claude 사용량을 Codex 계정에 적게 된다
    env["ACM_CODEX_ACCOUNT"] = name
    if sys.stderr.isatty():
        plan = f", {acc['plan']}" if acc.get("plan") else ""
        info(f"Codex {account_label(name, acc)} [{name}] ({acc.get('email') or ('로그인됨' if logged_in(acc) else '로그인 안 됨')}{plan}) · {why}")
    found = codex_bin()
    if found == "codex" and not shutil.which("codex"):
        die("codex 실행 파일을 PATH 에서 찾지 못했습니다")
    os.execve(found, [found] + argv, env) if os.path.isabs(found) else os.execvpe(found, [found] + argv, env)


def tools_available(data):
    """세션을 열 수 있는 도구. Codex 는 계정을 등록했거나 codex 와 ~/.codex 가 있을 때다."""
    out = ["claude"]
    if tool_accounts(data, "codex") or (os.path.isdir(CODEX_ROOT) and shutil.which("codex")):
        out.append("codex")
    return out


def ide_launched():
    """IDE 플러그인이 띄운 터미널인지. 거기서는 묻지 않고 Claude 로 띄운다."""
    return bool(os.environ.get("ENABLE_IDE_INTEGRATION") or os.environ.get("CLAUDE_CODE_SSE_PORT")
                or os.environ.get("TERMINAL_EMULATOR", "").startswith("JetBrains"))


def ask_tool(data):
    """인자 없이 acm 만 쳤을 때 어느 도구로 세션을 열지 묻는다. 터미널이 아니거나 도구가 하나뿐이면 Claude 다."""
    tools = tools_available(data)
    if len(tools) < 2 or not (sys.stdin.isatty() and sys.stderr.isatty()) or ide_launched():
        return "claude"
    menu = "\n".join(f"  {i}) {TOOL_NAMES[t]}" + ("  (기본)" if i == 1 else "") for i, t in enumerate(tools, 1))
    sys.stderr.write(f"어느 도구로 세션을 열까요?\n{menu}\n")
    try:
        for _ in range(3):
            sys.stderr.write("번호 [1]: ")
            sys.stderr.flush()
            ans = sys.stdin.readline()
            if not ans:
                return tools[0]
            ans = ans.strip().lower()
            if not ans:
                return tools[0]
            if ans.isdigit() and 1 <= int(ans) <= len(tools):
                return tools[int(ans) - 1]
            if ans in tools:
                return ans
    except KeyboardInterrupt:
        sys.stderr.write("\n")
        sys.exit(130)
    return tools[0]


ACM_OPTIONS = ("-a", "--acc", "--rr", "--usage")


def launch_plain(argv, binary, err, tool=None):
    """계정을 고르다 예상하지 못한 오류가 나면 계정을 고르지 않고 claude 나 codex 를 그대로 띄운다.
    셸 함수와 IDE 확장은 claude 를 acm 으로 보내서, acm 의 결함 하나가 claude 를 아예 못 쓰게 만들지 않게 한다."""
    name = "codex" if tool == "codex" else "claude"
    info(f"계정을 고르다 오류가 나서 {name} 를 그대로 띄웁니다 ({type(err).__name__}: {err}). acm doctor 로 확인하세요")
    while argv and argv[0] in ACM_OPTIONS:
        argv = argv[2:] if argv[0] in ("-a", "--acc") else argv[1:]
    found = codex_bin() if tool == "codex" else (binary or claude_bin())
    os.execv(found, [found] + argv) if os.path.isabs(found) else os.execvp(found, [found] + argv)


def forced_tool(data, argv):
    """-a 로 정한 계정의 도구. 못 찾으면 None. 대체 실행이 Codex 계정을 claude 로 띄우지 않게 미리 본다."""
    i = 0
    while i < len(argv) and argv[i] in ACM_OPTIONS:
        if argv[i] in ("-a", "--acc"):
            if i + 1 >= len(argv):
                return None
            key = argv[i + 1]
            names = sorted(data["order"], key=lambda n: (n != key, tool_of(data["accounts"][n]) != "claude"))
            for name in names:
                acc = data["accounts"][name]
                email = acc.get("email") or ""
                if key in (name, acc.get("label"), email, email.split("@")[0]):
                    return tool_of(acc)
            return None
        i += 1
    return None


def safe_launch(argv, binary=None, tool=None):
    try:
        data = load_accounts()
        tool = tool or forced_tool(data, argv)
        launch(data, argv, binary, tool=tool)
    except Exception as e:
        launch_plain(argv, binary, e, tool)


def main():
    argv = sys.argv[1:]
    # VS Code 계열 확장의 claudeProcessWrapper 로 불렸다. 첫 인자가 확장에 든 claude 다
    if argv and bundled_claude(argv[0]):
        binary, rest = argv[0], argv[1:]
        if rest and rest[0] in PASSTHROUGH:
            os.execv(binary, [binary] + rest)
        safe_launch(rest, binary)
        return
    if argv and argv[0] in ("help", "-h", "--help"):
        print(HELP)
        return
    # 발행 세션의 훅. accounts.json 을 읽다 실패해도 막는 쪽으로 끝나게 다른 일보다 먼저 받는다
    if argv[:2] == ["publisher", "guard"]:
        sys.exit(publisher_guard_main())
    # 상태 폴더에는 이메일과 사용량, 발행할 파일이 든다. 같은 Mac 의 다른 사용자가 읽지 못하게 나만 연다
    try:
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        os.chmod(STATE_DIR, 0o700)
    except OSError:
        pass
    if argv and argv[0] in COMMANDS:
        COMMANDS[argv[0]](load_accounts(), argv[1:])
        return
    # acm claude …, acm codex … 는 도구를 정해서 띄운다. 도구 이름 없이 인자를 주면 예전처럼 Claude 다
    if argv and argv[0] in TOOLS:
        safe_launch(argv[1:], tool=argv[0])
        return
    tool = None
    if not argv:
        try:
            tool = ask_tool(load_accounts())
        except Exception:
            tool = None
    safe_launch(argv, tool=tool)


if __name__ == "__main__":
    main()
